{
    "manifest_version": 3,
    "name": "JobLens",
    "version": "1.1.0",
    "description": "Detects whether a Product Engineer job posting is software-based on LinkedIn. Hides blocked and recently-applied companies.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "JobLens",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/company/*",
        "http://localhost:8001/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/jobs/*"
            ],
            "js": [
                "classifier.js",
                "highlighter.js",
                "blocker.js",
                "content-script.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.linkedin.com/company/*"
            ],
            "js": [
                "blocker.js",
                "company-page.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ]
}
